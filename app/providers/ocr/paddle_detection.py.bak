from __future__ import annotations

from typing import Any

import numpy as np

from app.core.detection.protocol import TextCandidate
from app.providers.errors import ProviderUnavailableError


class PaddleTextDetector:
    def __init__(self, engine: Any | None = None) -> None:
        if engine is not None:
            self.engine = engine
            return
        try:
            from paddleocr import PaddleOCR
        except ImportError as exc:
            raise ProviderUnavailableError("PaddleOCR is not installed; install the 'ai' dependencies") from exc
        try:
            self.engine = PaddleOCR(
                lang="ch",
                use_doc_orientation_classify=False,
                use_doc_unwarping=False,
                use_textline_orientation=False,
            )
        except TypeError:
            self.engine = PaddleOCR(lang="ch", use_angle_cls=False)

    @staticmethod
    def _bbox(poly: list[list[float]] | tuple[tuple[float, float], ...]) -> tuple[int, int, int, int]:
        points = np.asarray(poly, dtype=np.float32).reshape(-1, 2)
        x0, y0 = np.floor(points.min(axis=0)).astype(int)
        x1, y1 = np.ceil(points.max(axis=0)).astype(int)
        return int(x0), int(y0), int(max(1, x1 - x0)), int(max(1, y1 - y0))

    @staticmethod
    def _modern_items(raw: Any) -> list[tuple[list[list[float]], float]]:
        items: list[tuple[list[list[float]], float]] = []
        if not isinstance(raw, list):
            raw = list(raw)
        for result in raw:
            if hasattr(result, "json"):
                value = result.json
                result = value() if callable(value) else value
            if not isinstance(result, dict):
                continue
            polys = result.get("dt_polys") or result.get("rec_polys") or []
            scores = result.get("dt_scores") or result.get("rec_scores") or [1.0] * len(polys)
            for index, poly in enumerate(polys):
                score = float(scores[index]) if index < len(scores) else 1.0
                items.append((poly, score))
        return items

    @staticmethod
    def _legacy_items(raw: Any) -> list[tuple[list[list[float]], float]]:
        nodes = raw
        while isinstance(nodes, list) and len(nodes) == 1 and isinstance(nodes[0], list):
            nodes = nodes[0]
        items: list[tuple[list[list[float]], float]] = []
        if not isinstance(nodes, list):
            return items
        for node in nodes:
            if not isinstance(node, (list, tuple)) or len(node) < 2:
                continue
            poly = node[0]
            score_value = node[1]
            if isinstance(score_value, (list, tuple)):
                score_value = score_value[-1]
            try:
                items.append((poly, float(score_value)))
            except (TypeError, ValueError):
                continue
        return items

    def detect(self, frame: np.ndarray, frame_index: int) -> list[TextCandidate]:
        if hasattr(self.engine, "predict"):
            raw = self.engine.predict(frame)
            items = self._modern_items(raw)
        else:
            raw = self.engine.ocr(frame, rec=False, cls=False)
            items = self._legacy_items(raw)
        candidates: list[TextCandidate] = []
        for poly, score in items:
            bbox = self._bbox(poly)
            polygon = tuple((int(round(x)), int(round(y))) for x, y in np.asarray(poly).reshape(-1, 2))
            candidates.append(TextCandidate(bbox, polygon, score, frame_index))
        return candidates
